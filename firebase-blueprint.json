{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing authentication details, roles, and learning progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID matching Firebase Auth UID." },
        "email": { "type": "string", "format": "email", "description": "User email address." },
        "displayName": { "type": "string", "description": "Display name of the user or student." },
        "role": { "type": "string", "enum": ["student", "teacher", "scholar", "admin", "visitor"], "description": "Role of the user." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "OrphanApplication": {
      "title": "OrphanApplication",
      "description": "Application submitted for orphan care, sponsorship, or relief support.",
      "type": "object",
      "properties": {
        "trackingNumber": { "type": "string", "description": "Public tracking reference number (e.g. ALNOOR-ORPHAN-XXXXXX)." },
        "applicantName": { "type": "string", "description": "Guardian or applicant full name." },
        "relation": { "type": "string", "description": "Guardian relationship to the orphan." },
        "phone": { "type": "string", "description": "Contact telephone or WhatsApp number." },
        "nationalId": { "type": "string", "description": "National identification number." },
        "address": { "type": "string", "description": "Current address of the family." },
        "assistanceType": { "type": "string", "description": "Type of aid or sponsorship requested." },
        "orphanName": { "type": "string", "description": "Full name of the orphan child." },
        "orphanBirthDate": { "type": "string", "description": "Birth date of the orphan." },
        "orphanGender": { "type": "string", "enum": ["male", "female"], "description": "Gender of the orphan." },
        "academicLevel": { "type": "string", "description": "Current educational stage." },
        "healthNotes": { "type": "string", "description": "Health status and special notes." },
        "status": { "type": "string", "enum": ["pending", "in_review", "field_visit", "field_verified", "approved", "sponsored", "rejected"], "description": "Current workflow status." },
        "fieldNotes": { "type": "string", "description": "Notes from social worker or admin verification." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["trackingNumber", "applicantName", "phone", "orphanName", "status", "createdAt"]
    },
    "AcademyEnrollment": {
      "title": "AcademyEnrollment",
      "description": "Student enrollment in Quran memorization or Islamic science academy courses.",
      "type": "object",
      "properties": {
        "studentName": { "type": "string", "description": "Enrolled student full name." },
        "email": { "type": "string", "format": "email", "description": "Student contact email." },
        "country": { "type": "string", "description": "Student country of residence." },
        "track": { "type": "string", "description": "Chosen study track (e.g. Quran Memorization, Hadith, Fiqh)." },
        "level": { "type": "string", "description": "Proficiency level." },
        "preferredTime": { "type": "string", "description": "Preferred study session time." },
        "status": { "type": "string", "enum": ["enrolled", "active", "graduated", "cancelled"], "description": "Enrollment status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Enrollment timestamp." }
      },
      "required": ["studentName", "email", "track", "status", "createdAt"]
    },
    "WaqfDonation": {
      "title": "WaqfDonation",
      "description": "Charitable Waqf contribution or sponsorship pledge record.",
      "type": "object",
      "properties": {
        "donorName": { "type": "string", "description": "Donor name or Anonymous." },
        "amount": { "type": "number", "description": "Donation amount in USD." },
        "currency": { "type": "string", "description": "Currency code (default USD)." },
        "programId": { "type": "string", "description": "Target Waqf program or project." },
        "paymentMethod": { "type": "string", "description": "Payment channel used." },
        "status": { "type": "string", "enum": ["intent", "processing", "completed", "failed"], "description": "Payment status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["amount", "programId", "status", "createdAt"]
    },
    "DawahInquiry": {
      "title": "DawahInquiry",
      "description": "Inquiries, questions about Islam, requests for free Quran translations, and counselor dialogues.",
      "type": "object",
      "properties": {
        "inquiryType": { "type": "string", "enum": ["question", "free_quran", "counselor_request", "new_muslim"], "description": "Type of inquiry." },
        "fullName": { "type": "string", "description": "Inquirer full name." },
        "email": { "type": "string", "format": "email", "description": "Contact email." },
        "phone": { "type": "string", "description": "Phone or WhatsApp number." },
        "country": { "type": "string", "description": "Country of residence." },
        "preferredLanguage": { "type": "string", "description": "Language code." },
        "message": { "type": "string", "description": "Question or details." },
        "status": { "type": "string", "enum": ["pending", "assigned", "in_dialogue", "resolved"], "description": "Workflow status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["inquiryType", "fullName", "email", "message", "status", "createdAt"]
    },
    "NewMuslimProgress": {
      "title": "NewMuslimProgress",
      "description": "Confidential learning progress for newly reverted Muslims.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID." },
        "nativeLanguage": { "type": "string", "description": "Native language." },
        "shahadaCompleted": { "type": "boolean", "description": "Whether Shahada declaration has been guided." },
        "wuduMastered": { "type": "boolean", "description": "Whether ablution steps are mastered." },
        "prayerLevel": { "type": "string", "enum": ["learning", "daily_practicing", "consistent"], "description": "Prayer practice stage." },
        "memorizedSurahsCount": { "type": "number", "description": "Number of short Surahs memorized." },
        "mentorAssigned": { "type": "string", "description": "Assigned scholar or mentor name." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Record creation timestamp." }
      },
      "required": ["userId", "shahadaCompleted", "createdAt"]
    },
    "QuizSubmission": {
      "title": "QuizSubmission",
      "description": "Academy course quiz submissions and evaluated scores.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Student user ID." },
        "courseId": { "type": "string", "description": "Course identifier." },
        "quizId": { "type": "string", "description": "Quiz identifier." },
        "scorePercentage": { "type": "number", "description": "Achieved score 0-100." },
        "passed": { "type": "boolean", "description": "Whether score passes threshold." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." }
      },
      "required": ["userId", "courseId", "quizId", "scorePercentage", "passed", "createdAt"]
    },
    "CertificateRecord": {
      "title": "CertificateRecord",
      "description": "Verifiable Islamic science and Quran completion certificates.",
      "type": "object",
      "properties": {
        "certificateCode": { "type": "string", "description": "Public verification code (e.g. ALNOOR-CERT-XXXXXX)." },
        "recipientName": { "type": "string", "description": "Student full name." },
        "courseTitle": { "type": "string", "description": "Title of the completed course." },
        "track": { "type": "string", "description": "Study track." },
        "grade": { "type": "string", "description": "Evaluation grade." },
        "issuedAt": { "type": "string", "format": "date-time", "description": "Issuance date." }
      },
      "required": ["certificateCode", "recipientName", "courseTitle", "issuedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores individual user profile and preferences keyed by user ID."
    },
    "/orphan_applications/{applicationId}": {
      "schema": "OrphanApplication",
      "description": "Stores orphan sponsorship and assistance applications with status workflow."
    },
    "/enrollments/{enrollmentId}": {
      "schema": "AcademyEnrollment",
      "description": "Stores academy registrations and course enrollments."
    },
    "/donations/{donationId}": {
      "schema": "WaqfDonation",
      "description": "Stores Waqf shares and donation intent records."
    },
    "/dawah_inquiries/{inquiryId}": {
      "schema": "DawahInquiry",
      "description": "Stores non-Muslim questions, free Quran requests, and counselor bookings."
    },
    "/new_muslims/{userId}": {
      "schema": "NewMuslimProgress",
      "description": "Stores confidential learning roadmap for new Muslims with strict owner/admin access."
    },
    "/quiz_submissions/{submissionId}": {
      "schema": "QuizSubmission",
      "description": "Stores course test results and student grading records."
    },
    "/certificates/{certificateCode}": {
      "schema": "CertificateRecord",
      "description": "Stores verifiable completion certificates issued by the Complex."
    }
  }
}
