rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // GLOBAL SECURITY & AUTHENTICATION HELPERS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mekoogk@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // ENTITY VALIDATION HELPERS
    // ==========================================

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['student', 'teacher', 'scholar', 'admin', 'visitor'];
    }

    function isValidOrphanApplication(data) {
      return data.keys().hasAll(['trackingNumber', 'applicantName', 'phone', 'orphanName', 'status', 'createdAt']) &&
             data.trackingNumber is string &&
             data.trackingNumber.size() >= 5 &&
             data.trackingNumber.size() <= 40 &&
             data.applicantName is string &&
             data.applicantName.size() >= 2 &&
             data.applicantName.size() <= 120 &&
             data.phone is string &&
             data.phone.size() >= 6 &&
             data.phone.size() <= 30 &&
             data.orphanName is string &&
             data.orphanName.size() >= 2 &&
             data.orphanName.size() <= 120 &&
             data.status in ['pending', 'in_review', 'field_visit', 'field_verified', 'approved', 'sponsored', 'rejected'];
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll(['studentName', 'email', 'track', 'status', 'createdAt']) &&
             data.studentName is string &&
             data.studentName.size() >= 2 &&
             data.email is string &&
             data.track is string &&
             data.status in ['enrolled', 'active', 'graduated', 'cancelled'];
    }

    function isValidDonation(data) {
      return data.keys().hasAll(['amount', 'programId', 'status', 'createdAt']) &&
             data.amount is number &&
             data.amount > 0 &&
             data.programId is string &&
             data.status in ['intent', 'processing', 'completed', 'failed'];
    }

    // ==========================================
    // COLLECTION ACCESS RULES
    // ==========================================

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      isValidUserProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    // Orphan Applications Collection
    match /orphan_applications/{applicationId} {
      // Anyone can look up their own application by tracking number or admins can list
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isValidOrphanApplication(request.resource.data);
      allow update: if isAdmin() &&
                      request.resource.data.trackingNumber == resource.data.trackingNumber &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      isValidOrphanApplication(request.resource.data);
      allow delete: if isAdmin();
    }

    // Academy Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isValidEnrollment(request.resource.data);
      allow update: if isAdmin() &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      isValidEnrollment(request.resource.data);
      allow delete: if isAdmin();
    }

    // Waqf & Charity Donations Collection
    match /donations/{donationId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isValidDonation(request.resource.data);
      allow update: if isAdmin() &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      isValidDonation(request.resource.data);
      allow delete: if isAdmin();
    }

    // Connection testing node
    match /test/connection {
      allow read, write: if true;
    }
  }
}
